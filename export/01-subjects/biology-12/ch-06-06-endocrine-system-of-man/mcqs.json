  {
    "subjectSlug": "biology-12",
    "chapterSlug": "06-endocrine-system-of-man",
    "chapterTitle": "Endocrine System Of Man",
    "topicSlug": "6-4-feedback-mechanism",
    "topicTitle": "6.4 Feedback Mechanism",
    "_id": "k970q4v7zvects1mxr05h1gemh85pnff",
    "correctKey": "A",
    "explanation": "Feedback mechanisms are the primary tools used by organisms to maintain a stable internal environment (homeostasis) despite external fluctuations. Most hormonal feedback loops are negative feedback aimed at restoring a set point.",
    "lastAttempt": null,
    "locked": false,
    "noteId": "kx7btx5mkzyxg1gdq39fmkarzh85paf2",
    "options": [
      {
        "key": "A",
        "text": "To maintain homeostasis"
      },
      {
        "key": "B",
        "text": "To increase metabolic rate indefinitely"
      },
      {
        "key": "C",
        "text": "To ensure positive feedback occurs constantly"
      },
      {
        "key": "D",
        "text": "To prevent any change in the external environment"
      }
    ],
    "stem": "Which of the following is the primary goal of most feedback mechanisms in the human body?",
    "topicId": "ms70bg3r67rdz07nmcq4a82q5s85p332"
  },
  {
    "subjectSlug": "biology-12",
    "chapterSlug": "06-endocrine-system-of-man",
    "chapterTitle": "Endocrine System Of Man",
    "topicSlug": "6-4-feedback-mechanism",
    "topicTitle": "6.4 Feedback Mechanism",
    "_id": "k972hyhcrn4zc18r1p58rpm0fs85pza6",
    "correctKey": "B",
    "explanation": "Failure of negative feedback (e.g., destruction of beta cells in Type 1 Diabetes means no insulin is produced) leads to loss of blood glucose homeostasis, causing hyperglycemia and clinical illness. This demonstrates the critical role of feedback in maintaining health.",
    "lastAttempt": null,
    "locked": false,
    "noteId": "kx7btx5mkzyxg1gdq39fmkarzh85paf2",
    "options": [
      {
        "key": "A",
        "text": "The body enters a state of permanent stability"
      },
      {
        "key": "B",
        "text": "Homeostasis is disrupted, potentially leading to disease"
      },
      {
        "key": "C",
        "text": "The system automatically switches to positive feedback"
      },
      {
        "key": "D",
        "text": "The set point is permanently lowered"
      }
    ],
    "stem": "What happens if a negative feedback mechanism fails, as in Type 1 Diabetes where insulin-producing cells are destroyed?",
    "topicId": "ms70bg3r67rdz07nmcq4a82q5s85p332"
  },
